{
  "expo": {
    "name": "Aparté",
    "slug": "aparte",
    "scheme": "aparte",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aparte.app"
    },
    "android": {
      "package": "com.aparte.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Aparté utilise vos contacts pour vous aider à ajouter des personnes à votre cercle."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000",
      "router": {},
      "eas": {
        "projectId": "942b3015-fc5a-44fd-98a4-7f30b8ec6741"
      }
    }
  }
}
