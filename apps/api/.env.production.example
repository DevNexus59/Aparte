# Template de configuration de production pour cercle-api (Aparté).
# Ne PAS committer le vrai fichier .env — en k8s, ces valeurs sont fournies
# via ConfigMap (non-secrets) + Secret (secrets), voir deploy/k8s/.

NODE_ENV=production

# Serveur
PORT=4000

# Origines autorisées (CORS) — l'app mobile en production. Plusieurs valeurs
# possibles séparées par des virgules (ex. web + app).
# TODO: remplacer par ton vrai sous-domaine.
CORS_ORIGIN=https://api.aparte.example

# Base MySQL — dans le cluster k8s, DB_HOST pointe vers le Service headless
# du StatefulSet MySQL (voir deploy/k8s/11-mysql-statefulset.yaml).
DB_HOST=mysql.aparte.svc.cluster.local
DB_PORT=3306
DB_USER=aparte
DB_PASSWORD=change-me
DB_NAME=aparte

# Secrets JWT — à régénérer en prod : openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Clé de chiffrement au repos des messages (hex 64 caractères / 32 octets)
# openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=change-me-message-key-64-hex-chars
