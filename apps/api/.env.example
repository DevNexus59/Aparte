# Serveur
PORT=4000
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Base MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cercle

# Secrets JWT — à régénérer en prod (openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Clé de chiffrement au repos des messages (hex 64 caractères / 32 octets)
# openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=change-me-message-key-64-hex-chars
