# Serveur
PORT=4000
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Base MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cercle

# Secrets JWT — à régénérer en prod (openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Clé de chiffrement au repos des messages (hex 64 caractères / 32 octets)
# openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=change-me-message-key-64-hex-chars

# Emails transactionnels (Resend — https://resend.com)
# Sans clé : les emails sont simplement journalisés en console (mode dev).
RESEND_API_KEY=
EMAIL_FROM="Aparté <noreply@aparte.pierrefourdin.dev>"

# URL publique de l'API, utilisée dans les emails (lien de vérification, etc.)
APP_PUBLIC_URL=http://localhost:4000

# Compte de test pour la revue Google Play (section "Informations de
# connexion" de la Play Console). Créé/synchronisé automatiquement au
# démarrage de l'API et protégé de la purge des comptes non confirmés.
GOOGLE_REVIEW_EMAIL=
GOOGLE_REVIEW_PASSWORD=

# Suggestions IA (OpenAI) — accroches de conversation, idées de journal,
# enrichissement des questions hebdo.
# Sans clé : fonctionnalités désactivées silencieusement (NoopAIProvider,
# suggestions vides), aucune erreur.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
