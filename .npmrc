# pnpm + Expo : on remet les modules en mode "hoisted" (un seul node_modules
# physique au lieu de symlinks), parce que Expo et certaines libs RN ne savent
# pas suivre les symlinks pnpm correctement.
node-linker=hoisted

# Permissif sur les peer deps (sinon pnpm est plus strict que npm et bloque sur
# des warnings que npm laissait passer).
strict-peer-dependencies=false
auto-install-peers=true
