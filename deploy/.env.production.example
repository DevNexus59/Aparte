# Template de configuration prod pour deploy/docker-compose.prod.yml.
# Copie-le en `.env` dans le même dossier que docker-compose.prod.yml
# (ex. /opt/aparte/.env) sur portfolio-vm. Ne JAMAIS committer le vrai .env.

# ---- MySQL (service "mysql") ----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=aparte
MYSQL_USER=aparte
MYSQL_PASSWORD=change-me

# ---- API (service "api") ----
NODE_ENV=production
PORT=4000

# Origines autorisées (CORS) — l'app mobile en production. Plusieurs valeurs
# possibles séparées par des virgules (ex. web + app).
CORS_ORIGIN=https://aparte.pierrefourdin.dev

# DB_HOST=mysql : nom du service docker-compose, résolu via le réseau interne
# créé automatiquement par compose.
DB_HOST=mysql
DB_PORT=3306
DB_USER=aparte
DB_PASSWORD=change-me
DB_NAME=aparte

# Secrets JWT — à régénérer en prod : openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Clé de chiffrement au repos des messages (hex 64 caractères / 32 octets)
# openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=change-me-message-key-64-hex-chars

# Emails transactionnels (Resend — https://resend.com)
# Sans clé : les emails sont simplement journalisés dans les logs du conteneur.
RESEND_API_KEY=
EMAIL_FROM="Aparté <noreply@aparte.pierrefourdin.dev>"

# URL publique de l'API, utilisée dans les emails (lien de vérification, etc.)
APP_PUBLIC_URL=https://aparte.pierrefourdin.dev

# Compte de test pour la revue Google Play (section "Informations de
# connexion" de la Play Console) — créé/synchronisé au démarrage de l'API.
GOOGLE_REVIEW_EMAIL=
GOOGLE_REVIEW_PASSWORD=

# Suggestions IA (Google Gemini, via son endpoint compatible OpenAI) —
# accroches de conversation, idées de journal, enrichissement des questions
# hebdo. Clé gratuite sur https://aistudio.google.com/apikey
# Sans clé : fonctionnalités désactivées silencieusement, aucune erreur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
